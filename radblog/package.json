{
  "name": "radius-blog",
  "version": "0.0.1",
  "description": "Blog site for Radius",
  "main": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radius-project/radius.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/radius-project/radius/issues"
  },
  "homepage": "https://blog.radapp.io",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "hugo-extended": "0.164.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "build": "hugo --gc --minify",
    "build:preview": "hugo --gc --minify --buildDrafts --buildFuture",
    "start": "hugo server",
    "start:drafts": "hugo server --buildDrafts --navigateToChanged",
    "hugo": "hugo",
    "hugo:version": "hugo version",
    "hugo:mod:get": "hugo mod get",
    "hugo:mod:tidy": "hugo mod tidy",
    "hugo:mod:clean": "hugo mod clean --all",
    "hugo:mod:graph": "hugo mod graph",
    "clean": "hugo --gc && rimraf public resources"
  }
}
